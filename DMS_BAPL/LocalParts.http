@baseUrl = http://localhost:5215
@token = replace-with-a-valid-jwt
@locationId = 1
@transactionId = 1
@fromLocationId = 1
@toLocationId = 2
@d2dBillNo = 1

### Get workshop locations accessible to the logged-in user
GET {{baseUrl}}/api/LocalParts/locations
Authorization: Bearer {{token}}

### Get dealer-created Spares and current stock for a workshop
GET {{baseUrl}}/api/LocalParts/parts?locationId={{locationId}}
Authorization: Bearer {{token}}

### Get local-parts receipt transactions
GET {{baseUrl}}/api/LocalParts/transactions?fromDate=2026-10-20&toDate=2026-11-19&locationId={{locationId}}
Authorization: Bearer {{token}}

### Get a local-parts transaction for editing
GET {{baseUrl}}/api/LocalParts/transactions/{{transactionId}}
Authorization: Bearer {{token}}

### Update a local-parts transaction
PUT {{baseUrl}}/api/LocalParts/transactions/{{transactionId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "prefix": "LOCAL/2026/001",
  "purchaseQuantity": 10
}

### Delete (void) a local-parts transaction
DELETE {{baseUrl}}/api/LocalParts/transactions/{{transactionId}}
Authorization: Bearer {{token}}

### Post local parts and increase stock
POST {{baseUrl}}/api/LocalParts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "prefix": "LOCAL/2026/001",
  "date": "2026-11-19T00:00:00Z",
  "locationId": {{locationId}},
  "items": [
    {
      "partCode": "PART-EXAMPLE-001",
      "purchaseQuantity": 10
    }
  ]
}

### Get all Parts D2D transactions available to the logged-in dealer
GET {{baseUrl}}/api/LocalParts/d2d/history
Authorization: Bearer {{token}}

### Get the next sequential Parts D2D bill number preview
GET {{baseUrl}}/api/LocalParts/d2d/next-bill-no
Authorization: Bearer {{token}}

### Get Parts D2D receipt notifications with pending/received status
GET {{baseUrl}}/api/LocalParts/d2d/notifications
Authorization: Bearer {{token}}

### Get a Parts D2D receipt by bill number
GET {{baseUrl}}/api/LocalParts/d2d/receipt/{{d2dBillNo}}
Authorization: Bearer {{token}}

### Save a Parts D2D transfer (the API assigns the next bill number)
POST {{baseUrl}}/api/LocalParts/d2d
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "prefix": "D2D/2026/001",
  "date": "2026-11-23T00:00:00Z",
  "fromLocationId": {{fromLocationId}},
  "toLocationId": {{toLocationId}},
  "items": [
    {
      "partCode": "PART-EXAMPLE-001",
      "transferQuantity": 1
    }
  ]
}

### Acknowledge a pending Parts D2D receipt without posting stock a second time
POST {{baseUrl}}/api/LocalParts/d2d/receipt/{{d2dBillNo}}/accept
Authorization: Bearer {{token}}

### Cancel a pending Parts D2D receipt and reverse stock when no later movements exist
DELETE {{baseUrl}}/api/LocalParts/d2d/receipt/{{d2dBillNo}}
Authorization: Bearer {{token}}
